{
  "name": "@ponchia/pulse",
  "version": "0.2.0-beta.0",
  "description": "Private, portable project analytics without another visitor tracker.",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Ponchia/bronto-pulse.git"
  },
  "bugs": {
    "url": "https://github.com/Ponchia/bronto-pulse/issues"
  },
  "engines": {
    "node": ">=24.15.0"
  },
  "bin": {
    "pulse": "./dist/cli.js"
  },
  "exports": {
    ".": "./dist/index.js",
    "./worker": "./dist/worker.js"
  },
  "files": [
    "dist",
    "web",
    "migrations",
    "examples",
    "README.md",
    "LICENSE",
    "docs",
    "SECURITY.md",
    "CHANGELOG.md",
    "CONTRIBUTING.md",
    "schemas"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --import tsx --test tests/*.test.ts tests/*.test.mjs",
    "test:coverage": "node --import tsx --experimental-test-coverage --test tests/*.test.ts tests/*.test.mjs",
    "test:browser": "playwright test",
    "check": "npm run format:check && npm run typecheck && npm run typecheck:tests && npm test && npm run docs:check && npm run build && npm run schema:check && npm run package:check && npm run repo:check && npm run publication:check",
    "docs:check": "node scripts/docs-check.mjs",
    "dev": "tsx src/cli.ts serve",
    "demo": "tsx src/cli.ts demo",
    "pulse": "tsx src/cli.ts",
    "worker:check": "wrangler deploy --dry-run",
    "worker:dev": "wrangler dev",
    "prepare": "npm run build",
    "schema:generate": "node scripts/generate-schema.mjs",
    "test:d1": "node --import tsx scripts/d1-contract.mts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "schema:check": "node scripts/schema-check.mjs",
    "package:check": "node scripts/package-check.mjs",
    "repo:check": "node scripts/quality-contract.mjs",
    "typecheck:tests": "tsc -p tsconfig.tests.json --noEmit",
    "publication:check": "node scripts/publication-check.mjs",
    "publisher:readiness": "node scripts/source-publisher.mjs readiness",
    "test:worker": "npm run build && node scripts/worker-contract.mjs && node scripts/access-contract.mjs && node scripts/native-aggregate-contract.mjs"
  },
  "dependencies": {
    "jose": "6.2.13",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20261025.1",
    "@playwright/test": "1.64.1",
    "@types/node": "^24.0.0",
    "prettier": "3.9.10",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "wrangler": "4.152.0"
  },
  "types": "./dist/index.d.ts",
  "overrides": {
    "miniflare@5.20261019.1-beta": {
      "undici": "7.30.1"
    }
  },
  "publishConfig": {
    "access": "public",
    "tag": "beta"
  }
}
