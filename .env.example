# Values are loaded from the environment, never from the project manifest.
# CLI: node --env-file=.env dist/cli.js sync --config pulse.config.json
GITHUB_TOKEN=
CLOUDFLARE_API_TOKEN=
# Optional Google short-lived token, refresh-token OR service-account configuration:
GOOGLE_ACCESS_TOKEN=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
GSC_SERVICE_ACCOUNT_JSON=
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
PULSE_API_TOKEN=
