# Values are loaded from the environment, never from the project manifest.
# CLI: node --env-file=.env dist/cli.js sync --config pulse.config.json
GITHUB_TOKEN=
CLOUDFLARE_API_TOKEN=
# Optional Google short-lived token, refresh-token OR service-account configuration:
GOOGLE_ACCESS_TOKEN=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
GSC_SERVICE_ACCOUNT_JSON=
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
PULSE_API_TOKEN=

# Optional portable Docker Compose deployment behind a TLS reverse proxy.
# Copy .env.example to .env and keep that file private.
# Bind the host-side Docker port only to 127.0.0.1 as compose.yaml specifies.
PULSE_PUBLIC_ORIGIN=
PULSE_LOCAL_PORT=
# One job per cycle by default; source-specific quotas still apply.
PULSE_COLLECT_INTERVAL_SECONDS=
PULSE_COLLECT_MAX_JOBS=
