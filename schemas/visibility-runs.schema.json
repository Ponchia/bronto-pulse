{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "type": "number",
      "const": 1
    },
    "suiteId": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_-]{0,63}$"
    },
    "suiteVersion": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "sessions": {
      "minItems": 1,
      "maxItems": 100,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_-]{0,63}$"
          },
          "provider": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "product": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "model": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "date": {
            "type": "string",
            "format": "date",
            "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))$"
          },
          "searchMode": {
            "type": "string",
            "enum": [
              "on",
              "off",
              "unknown"
            ]
          },
          "context": {
            "type": "string",
            "enum": [
              "fresh",
              "continuing",
              "unknown"
            ]
          },
          "repeats": {
            "type": "integer",
            "minimum": 1,
            "maximum": 10
          }
        },
        "required": [
          "id",
          "provider",
          "product",
          "model",
          "date",
          "searchMode",
          "context",
          "repeats"
        ],
        "additionalProperties": false
      }
    },
    "runs": {
      "maxItems": 10000,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "sessionId": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_-]{0,63}$"
          },
          "promptId": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_-]{0,63}$"
          },
          "promptHash": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "language": {
            "type": "string",
            "enum": [
              "en",
              "it",
              "es"
            ]
          },
          "repeat": {
            "type": "integer",
            "minimum": 1,
            "maximum": 10
          },
          "status": {
            "type": "string",
            "enum": [
              "completed",
              "unrun",
              "error"
            ]
          },
          "rawAnswer": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 200000
              },
              {
                "type": "null"
              }
            ]
          },
          "citations": {
            "anyOf": [
              {
                "maxItems": 200,
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "url": {
                      "type": "string",
                      "maxLength": 2048,
                      "format": "uri"
                    },
                    "evidence": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 2000
                    }
                  },
                  "required": [
                    "url",
                    "evidence"
                  ],
                  "additionalProperties": false
                }
              },
              {
                "type": "null"
              }
            ]
          },
          "reviews": {
            "maxItems": 20,
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "targetId": {
                  "type": "string",
                  "pattern": "^[a-z][a-z0-9_-]{0,63}$"
                },
                "reviewer": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 200
                },
                "reviewedAt": {
                  "type": "string",
                  "format": "date-time",
                  "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
                },
                "recommendation": {
                  "type": [
                    "boolean",
                    "null"
                  ]
                },
                "misrepresentation": {
                  "type": [
                    "boolean",
                    "null"
                  ]
                },
                "notes": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 4000
                }
              },
              "required": [
                "targetId",
                "reviewer",
                "reviewedAt",
                "recommendation",
                "misrepresentation",
                "notes"
              ],
              "additionalProperties": false
            }
          }
        },
        "required": [
          "sessionId",
          "promptId",
          "promptHash",
          "language",
          "repeat",
          "status",
          "rawAnswer",
          "citations",
          "reviews"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "schemaVersion",
    "suiteId",
    "suiteVersion",
    "sessions",
    "runs"
  ],
  "additionalProperties": false
}
